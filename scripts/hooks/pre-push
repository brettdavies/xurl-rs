#!/usr/bin/env bash
# Canonical version: 2026.11.03 (generic)
#
# Local CI mirror: the whole-repo pre-push gate. Runs the same checks as the
# GitHub Actions CI pipeline, so a push that survives the hook passes CI and a
# push that fails the hook would have failed CI anyway, just slower. Its fast,
# staged-file-scoped companion is scripts/hooks/pre-commit. Use as a pre-push
# hook or run manually before pushing.
#
# Every shared check comes from scripts/hooks/_lib.sh, which both hooks source.
# The two hooks differ in scope, not in what a check means: pre-push passes
# what the push carries, pre-commit passes the staged set. The library battery
# and the Windows checks stay inline because pre-commit has no use for them.
#
# Scoped by what the push actually changes: every step below runs only when a
# path it could possibly read is in the push range, so a docs-only push does
# not pay for a full Rust battery. The scoping fails open (an unrecognized path
# runs everything, and a hand-run hook sweeps the whole repo) because a guard
# that wrongly skips is worse than one that wrongly runs.
#
# A commit any remote-tracking branch of the pushed remote reaches counts as
# already checked, so a tag or new branch at one runs nothing.
#
# Activate per clone via: git config core.hooksPath scripts/hooks
# core.hooksPath is machine-local git config: it does NOT travel with the
# clone and is not enforced by cloning. Run the command above once per fresh
# clone, human and agent workspace alike.
#
# Defensive no-ops, but never silent: each optional step guards on its tool
# being present and skips cleanly when absent. The library announces every such
# skip, and a skipped check never prints a pass line.
#
# Exit codes: 0 = all pass, 1 = failure
#
# Requires bash >= 4.4 (mapfile, and empty-array expansion under `set -u`). The
# guard re-execs under Homebrew's bash when `#!/usr/bin/env bash` found an older
# one, such as the macOS /bin/bash 3.2, and otherwise stops with the install hint.
if ((BASH_VERSINFO[0] < 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 4))); then
  for b in /opt/homebrew/bin/bash /usr/local/bin/bash; do
    [ -x "$b" ] && exec "$b" "$0" "$@"
  done
  echo "ERROR: needs bash >= 4.4 (running $BASH_VERSION); install it with: brew install bash" >&2
  exit 1
fi

# A linked worktree can find core.hooksPath set to the main checkout's
# absolute path (worktree tooling writes it), and git then runs the main
# checkout's copy of this hook with the worktree as its working directory.
# Hand off to the copy that worktree has checked out, so a push or commit is
# gated by the hook its own branch carries.
hook_self_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)
hook_worktree_root=$(pwd -P)
hook_own_copy="$hook_worktree_root/scripts/hooks/$(basename "${BASH_SOURCE[0]}")"
if [[ "$hook_worktree_root" != "$hook_self_root" && -x "$hook_own_copy" ]]; then
  exec "$hook_own_copy" "$@"
fi

# From a linked worktree git exports GIT_DIR, which sends a tool's git calls in
# any directory to this repository: cargo-deny 0.19.1 through 0.19.5 reset the
# pushed branch during the advisory fetch (fixed in 0.19.6,
# https://github.com/EmbarkStudios/cargo-deny/pull/858), and the xdk build
# script resolves HEAD through it. Pre-push has no temporary index, and
# discovery from the hook's cwd (the worktree root) finds the same repository.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR GIT_OBJECT_DIRECTORY \
  GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_PREFIX GIT_NAMESPACE

set -uo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root" || exit 1
# A CI action that checks one file at a time without -x reports SC1091 here.
# shellcheck source=scripts/hooks/_lib.sh disable=SC1091
. ./scripts/hooks/_lib.sh || exit 1

if push_only_deletes; then
  echo "Nothing to check: the push only deletes."
  exit 0
fi

# A real push passes the remote's name and URL. With no ref lines after them,
# no ref would update, so there is nothing to check. A hand run passes neither
# and checks everything.
if [ "$#" -ge 2 ] && [ -z "${HOOK_PUSH_REFS:-}" ]; then
  echo "pre-push: nothing to push"
  exit 0
fi

# A tag, or a new branch, at a commit the remote already has brings no commit
# for any check to read.
if push_only_known_commits "${1:-}"; then
  echo "Nothing to check: every pushed commit is already on $1."
  exit 0
fi

# `fail` exits: the Rust battery below is ordered by cost, so continuing past a
# failed fmt to run clippy, the test suite and a cross-target type-check would
# spend minutes restating what the first line already said. Every `step` below
# ends the run the same way.
fail() {
  step_failed "$1"
  exit 1
}

# ── What this push changes ────────────────────────────────────────────────
#
# pushed_paths reads the ref lines push_only_deletes kept, and a new ref by
# the commits no remote-tracking branch of the pushed remote reaches. A hand
# run, a remote with no remote-tracking branch, or a range git cannot read
# sweeps everything.
scope_all=false
changed=""
changed=$(pushed_paths "${1:-}") || scope_all=true

# touched <extended-regex>: true when the push carries a matching path.
# Every test below reads a string rather than a pipe: `grep -q` exits at its
# first match, and under pipefail the writer's broken pipe turns that match
# into a false.
touched() {
  $scope_all && return 0
  grep -qE "$1" <<<"$changed"
}

# The cargo steps run unless the pushed paths are known and
# scripts/cargo-inputs.sh, the classifier CI's `Change scope` job runs, finds no
# cargo input among them (see needs_cargo).
run_cargo=true
if ! $scope_all && ! needs_cargo "$changed"; then
  run_cargo=false
fi

# library_touched: false only when every cargo input the push carries sits
# under crates/xurl-cli, which cannot move a `-p xdk-rs` build. The library
# gates it guards are the slowest in the hook, but the test fails open: a
# classifier that fails or an unrecognized path runs them. CI runs them
# regardless.
library_touched() {
  local inputs
  $scope_all && return 0
  inputs=$(bash scripts/cargo-inputs.sh <<<"$changed") || return 0
  [ -n "$inputs" ] && grep -qv '^crates/xurl-cli/' <<<"$inputs"
}

banner "Running local CI checks..."
if ! $scope_all; then
  note "scope: $(grep -cv '^$' <<<"$changed") changed path(s) in this push"
fi

# ── Rust battery (toolchain through Windows cross-clippy) ─────────────────
if $run_cargo; then
  # The toolchain is pinned in rust-toolchain.toml; local and CI read the same
  # file and install the same version. Rustup verifies component SHA256s from
  # the distribution manifest, so the pin is effectively a SHA pin. No `rustup
  # update` step here: bumping the toolchain is a reviewed PR that updates
  # rust-toolchain.toml.
  show_toolchain

  # 1. Format check
  step "fmt" "cargo fmt -- --check" check_cargo_fmt || exit 1

  # 2. Clippy with warnings-as-errors: CI's RUSTFLAGS=-Dwarnings as a clippy
  # argument, since cargo keys every dependency build on RUSTFLAGS.
  step "clippy" "cargo clippy --workspace -- -D warnings" check_clippy --workspace || exit 1

  # 3. Tests
  step "test" "cargo test --workspace" check_tests --workspace || exit 1

  # 4. MSRV check: the codebase still compiles against the rust-version
  # declared in the workspace manifest. The crates declare a lower MSRV than
  # the pinned rust-toolchain.toml; this step validates the declared promise so
  # library consumers on the MSRV still see a working crate. The virtual
  # manifest makes a bare `cargo check` cover every member. Requires the MSRV
  # toolchain installed; the library skips with a hint otherwise.
  msrv=$(msrv_version)
  step "msrv${msrv:+ ($msrv)}" "cargo +${msrv:-MSRV} check --workspace" check_msrv || exit 1

  # 5. Doc build: catch doc-comment breakage (broken intra-doc links, missing
  # code-fence markers) that would render badly on docs.rs. RUSTDOCFLAGS=-D
  # warnings treats every doc warning as an error.
  step "doc" "cargo doc --workspace --no-deps (RUSTDOCFLAGS=-D warnings)" check_doc || exit 1

  # ── Library battery (steps 6-10), only when the push reaches crates/xdk ──
  if library_touched; then
    # 6. Examples compile under the default features; the one that needs the
    # mock is skipped here by its required-features and run in step 7.
    cargo build --examples -p xdk-rs --quiet 2>&1 || fail "cargo build --examples -p xdk-rs"
    pass "examples"

    # 7. The credential-free example runs against the in-process mock; its
    # assertions are what turn a broken runtime path into a failure.
    cargo run -p xdk-rs --example offline_search --features testing --quiet >/dev/null 2>&1 \
      || fail "cargo run -p xdk-rs --example offline_search --features testing"
    pass "example run (offline_search)"

    # 8. TLS backends: native-tls by itself must compile, and no backend at all
    # must fail on the guard rather than compile silently.
    cargo check -p xdk-rs --no-default-features --features native-tls --quiet 2>&1 \
      || fail "cargo check -p xdk-rs --no-default-features --features native-tls"
    if no_tls_log=$(cargo check -p xdk-rs --no-default-features --quiet 2>&1); then
      fail "cargo check -p xdk-rs --no-default-features compiled; the TLS guard in crates/xdk/src/lib.rs is gone"
    elif ! grep -q "needs a TLS backend" <<<"$no_tls_log"; then
      fail "cargo check -p xdk-rs --no-default-features failed, but not on the TLS guard"
    fi
    pass "tls features (native-tls alone; no backend refused)"

    # 9. The docs.rs feature set: xdk-rs documented with every feature, as
    # docs.rs builds it, the only doc build that reaches the `testing` module.
    RUSTDOCFLAGS="-D warnings" cargo doc -p xdk-rs --no-deps --all-features --quiet 2>&1 \
      || fail "cargo doc -p xdk-rs --no-deps --all-features (RUSTDOCFLAGS=-D warnings)"
    pass "docs.rs feature set"

    # 10. Every feature subset that carries a backend, as CI's powerset job
    # runs it. Skips with a hint when cargo-hack is not installed.
    if cargo hack --version >/dev/null 2>&1; then
      cargo hack check -p xdk-rs --feature-powerset --at-least-one-of rustls,native-tls --exclude-no-default-features --quiet 2>&1 \
        || fail "cargo hack check -p xdk-rs --feature-powerset --at-least-one-of rustls,native-tls --exclude-no-default-features"
      pass "feature powerset (cargo hack)"
    else
      echo "  - feature powerset (skipped: install via \`cargo binstall cargo-hack\` to enable)"
    fi
  else
    note "library battery (nothing in this push reaches crates/xdk)"
  fi

  # 11. Security audit (licenses + advisories)
  step "deny" "cargo deny check" check_deny || exit 1

  # 12. Output discipline: the same guard CI's `lint-stdio` job runs. No naked
  # stdio macro outside the output module, no terminal handle in library code.
  # Its stderr carries each offending file and line, or rg's own error and the
  # fix line, so only its OK line is silenced.
  if have rg; then
    bash scripts/lint-stdio.sh >/dev/null || fail "scripts/lint-stdio.sh"
    pass "lint-stdio"
  else
    skip "lint-stdio" "install via \`brew install ripgrep\`"
  fi

  # 13. Windows cross-check (fast): verify no unconditional use of unix-only
  # APIs. Catches the libc::SIGPIPE class of issue without invoking a Windows
  # toolchain; runs in milliseconds. Step 14 is the comprehensive backstop.
  # Each hit is judged by the `cfg(unix)` lookback below, so the search runs
  # once and every hit goes through that one check.
  check_windows_libc() {
    have rg || skip "windows compat (libc grep)" "install via \`brew install ripgrep\`" || return
    local violations file lineno before rc=0
    violations=$(rg -n 'libc::(SIGPIPE|SIG_DFL|signal)' --type rust crates/ 2>/dev/null || true)
    [ -n "$violations" ] || return 0
    while IFS= read -r line; do
      file=${line%%:*}
      lineno=$(echo "$line" | cut -d: -f2)
      before=$(sed -n "$((lineno > 3 ? lineno - 3 : 1)),${lineno}p" "$file")
      # Here-string, not a pipe: `rg -q` exits at its first match, and under
      # `pipefail` that kills the producer and makes a *matching* pipeline
      # non-zero, which this `!` would read as "no cfg(unix) found" and fail a
      # correctly-gated call site.
      if ! rg -q 'cfg\(unix\)' <<<"$before"; then
        step_failed "libc unix-only API used without #[cfg(unix)] at $file:$lineno"
        rc=1
      fi
    done <<<"$violations"
    return "$rc"
  }
  step "windows compat (libc grep)" "unix-only libc API outside #[cfg(unix)]" check_windows_libc || exit 1

  # 14. Windows cross-clippy: full type-check of the codebase as if compiling
  # for x86_64-pc-windows-gnu. Catches cfg-gated unused imports, conditional
  # dead code, and any other warning class that only surfaces on Windows. Linux
  # clippy alone misses these because `#[cfg(unix)]` filters out their usage
  # sites locally: the warning only fires on the platform where the gate
  # excludes them.
  #
  # Requirements (one-time setup):
  #   sudo apt install mingw-w64                          # the C linker tree-sitter needs
  #   rustup target add x86_64-pc-windows-gnu             # the Windows std library
  #
  # If either is missing the step is skipped with a one-line note rather than
  # failing, but local Windows coverage is then absent, and CI's Windows job
  # becomes the only backstop. Install both to close that gap.
  check_windows_clippy() {
    have x86_64-w64-mingw32-gcc \
      && grep -q '^x86_64-pc-windows-gnu$' <<<"$(rustup target list --installed 2>/dev/null)" \
      || skip "windows clippy (cross-target)" \
        "install \`mingw-w64\` + \`rustup target add x86_64-pc-windows-gnu\`" || return
    cargo clippy --workspace --target x86_64-pc-windows-gnu --all-targets --quiet -- -D warnings 2>&1
  }
  step "windows clippy (cross-target)" "cargo clippy --target x86_64-pc-windows-gnu -- -D warnings" \
    check_windows_clippy || exit 1
else
  note "rust battery (nothing in this push reaches cargo)"
fi

# ── Lint (steps 15-17) ────────────────────────────────────────────────────
# These take no build lock and read disjoint files, so they run together and
# the slowest sets their wall-clock; step_wait replays them in queue order.
# markdownlint is the one that writes, and only to the markdown no other check
# reads.

# 15. Shellcheck over every tracked script, the hooks included.
if touched '(\.sh$|^scripts/hooks/)'; then
  step_bg "shellcheck" "shellcheck --severity=warning <file>" check_shell_all
else
  note "shellcheck (no shell script in this push)"
fi

# 16. Markdown lint, over tracked files. This checks the same set as the
# `lint / markdownlint` CI job: that job globs a clean checkout, which holds
# exactly the tracked files, minus the generated `CHANGELOG.md`.
#
# `git ls-files` rather than a `**/*.md` glob because the shared config sets
# `fix: true`, so this "check" rewrites what it matches, and a working clone
# carries symlinked directories (`.claude/`, `docs/solutions`) that a glob can
# descend into and edit outside the repo. A pathspec cannot leave the repo.
if touched '\.md$'; then
  mapfile -t md_files < <(tracked_markdown)
  step_bg "markdownlint" "markdownlint-cli2 <file>" check_markdownlint "${md_files[@]}"
else
  note "markdownlint (no markdown in this push)"
fi

# 17. Workflow lint and group namespacing. Mirrors the `lint / actionlint` CI job.
if touched '^\.github/workflows/.*\.ya?ml$'; then
  step_bg "actionlint" "actionlint" check_actionlint_all
  step_bg "concurrency namespacing" "scripts/check-workflow-concurrency.sh" check_workflow_concurrency_all
else
  note "actionlint (no workflow in this push)"
fi

step_wait || exit 1

banner "All checks passed."
