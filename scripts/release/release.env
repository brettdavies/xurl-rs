# Per-repo release values, sourced by scripts/release/_lib.sh. Every entry
# point (preflight, postflight, sync-dev) reads it, so a value belongs here
# rather than in whichever script happens to need it first.

# The workspace root is a virtual manifest, so the version a `vX.Y.Z` tag names
# lives in the binary crate. The library releases on its own `xdk-rs-v*` line
# and is resolved from the tag, not from this value.
RELEASE_MANIFEST="crates/xurl-cli/Cargo.toml"

# Each member keeps its changelog beside its own manifest, so the binary's is
# not at the repository root.
RELEASE_CHANGELOG="crates/xurl-cli/CHANGELOG.md"

# Version carriers drift.sh watches. The workspace adds each member manifest
# and the library's own changelog; a carrier omitted here has its release-time
# edit read as ordinary drift.
VERSION_CARRIERS="Cargo.toml crates/xurl-cli/Cargo.toml crates/xdk/Cargo.toml package.json pyproject.toml VERSION crates/xurl-cli/CHANGELOG.md crates/xdk/CHANGELOG.md"
