{
  "schema_version": 1,
  "type": "agent-skill",
  "name": "xurl-rs",
  "version": "1.3.0",
  "description": "Fast, ergonomic CLI for the X (Twitter) API with OAuth1/2, Bearer, media upload, and streaming.",
  "license": "MIT OR Apache-2.0",
  "source": {
    "type": "git",
    "url": "https://github.com/brettdavies/xurl-rs-skill.git"
  },
  "install": {
    "claude_code": "git clone --depth 1 https://github.com/brettdavies/xurl-rs-skill.git ~/.claude/skills/xurl-rs",
    "codex": "git clone --depth 1 https://github.com/brettdavies/xurl-rs-skill.git ~/.codex/skills/xurl-rs",
    "cursor": "git clone --depth 1 https://github.com/brettdavies/xurl-rs-skill.git ~/.cursor/skills/xurl-rs",
    "factory": "git clone --depth 1 https://github.com/brettdavies/xurl-rs-skill.git ~/.factory/skills/xurl-rs",
    "kiro": "git clone --depth 1 https://github.com/brettdavies/xurl-rs-skill.git ~/.kiro/skills/xurl-rs",
    "opencode": "git clone --depth 1 https://github.com/brettdavies/xurl-rs-skill.git ~/.config/opencode/skills/xurl-rs"
  },
  "config_dir_env": {
    "claude_code": {
      "var": "CLAUDE_CONFIG_DIR",
      "replaces": "~/.claude",
      "source": "https://code.claude.com/docs/en/claude-directory"
    },
    "codex": {
      "var": "CODEX_HOME",
      "replaces": "~/.codex",
      "source": "https://developers.openai.com/codex/config-advanced"
    },
    "cursor": {
      "var": null,
      "source": "https://cursor.com/docs/skills",
      "note": "No documented variable relocates ~/.cursor/skills; CURSOR_CONFIG_DIR covers only the CLI settings file."
    },
    "factory": {
      "var": null,
      "source": "https://docs.factory.ai/cli/configuration/skills",
      "note": "No documented variable relocates ~/.factory."
    },
    "kiro": {
      "var": "KIRO_HOME",
      "replaces": "~/.kiro",
      "source": "https://kiro.dev/docs/reference/settings/"
    },
    "opencode": {
      "var": "OPENCODE_CONFIG_DIR",
      "replaces": "~/.config/opencode",
      "source": "https://opencode.ai/docs/config/"
    }
  },
  "update": "cd <install-dir> && git pull --ff-only",
  "uninstall": "rm -rf <install-dir>"
}
