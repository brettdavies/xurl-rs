
use builtin;
use str;

set edit:completion:arg-completer[xr] = {|@words|
    fn spaces {|n|
        builtin:repeat $n ' ' | str:join ''
    }
    fn cand {|text desc|
        edit:complex-candidate $text &display=$text' '(spaces (- 14 (wcswidth $text)))$desc
    }
    var command = 'xr'
    for word $words[1..-1] {
        if (str:has-prefix $word '-') {
            break
        }
        set command = $command';'$word
    }
    var completions = [
        &'xr'= {
            cand -X 'HTTP method (GET by default)'
            cand --method 'HTTP method (GET by default)'
            cand -H 'Request headers'
            cand --header 'Request headers'
            cand -d 'Request body data'
            cand --data 'Request body data'
            cand --auth 'Authentication type (oauth2, oauth1, app)'
            cand -u '`OAuth2` login to send the request as, by the name it is stored under: its username, or the name given to `xr auth oauth2`'
            cand --username '`OAuth2` login to send the request as, by the name it is stored under: its username, or the name given to `xr auth oauth2`'
            cand -v 'Print request and response lines, and a note for each key X sent in its legacy post vocabulary'
            cand --verbose 'Print request and response lines, and a note for each key X sent in its legacy post vocabulary'
            cand -F 'File to upload (for multipart requests)'
            cand --file 'File to upload (for multipart requests)'
            cand --app 'Use a specific registered app (overrides default)'
            cand --output 'Output format. text (default), json, jsonl, ndjson (alias of jsonl), yaml (alias `yml`), csv, tsv. Any other value (toml, xml) is refused at exit 2 with a JSON envelope whose reason is `invalid-args`'
            cand --raw 'Emit unstyled, compact output. Strips ANSI in text mode; prints `json` output on one line, as `jsonl` and `ndjson` always are'
            cand -q 'Suppress all non-essential output (errors still go to stderr)'
            cand --quiet 'Suppress all non-essential output (errors still go to stderr)'
            cand --no-interactive 'Disable interactive prompts; fail with error instead'
            cand --timeout 'Request timeout in seconds'
            cand --wait-on-rate-limit 'Wait out a rate limit and retry once, instead of failing with `rate-limited`'
            cand --rate-limit-max-wait 'Longest `--wait-on-rate-limit` waits before its retry, in seconds'
            cand --color 'Colorize output: auto (TTY-aware), always, or never'
            cand --dry-run 'Check inputs and credentials offline, and send nothing'
            cand --limit 'Page size for every command that takes `-n/--max-results`, when `-n` is not given; other commands and raw requests ignore it'
            cand --cursor 'The `meta.next_token` of the previous page, for every command whose endpoint pages; other commands and raw requests ignore it'
            cand --page 'Documented alias for `--cursor`'
            cand --after 'Documented alias for `--cursor` (`--after <token>`)'
            cand -t 'Add trace header to request'
            cand --trace 'Add trace header to request'
            cand -s 'Force streaming mode'
            cand --stream 'Force streaming mode'
            cand --json 'Shorthand for `--output json` (P2 alias)'
            cand --jsonl 'Shorthand for `--output jsonl` (P2 alias)'
            cand --no-pager 'Documented no-op. `xr` writes directly to stdout and never invokes `$PAGER`; this flag is advertised so agents can pass `--no-pager` unconditionally without xr rejecting it'
            cand -h 'Print help (see more with ''--help'')'
            cand --help 'Print help (see more with ''--help'')'
            cand -V 'Print version'
            cand --version 'Print version'
            cand post 'Post to X'
            cand reply 'Reply to a post'
            cand quote 'Quote a post'
            cand delete 'Delete a post'
            cand read 'Read a post'
            cand analytics 'Report impressions and engagement for your posts over a time window'
            cand search-counts 'Count the recent posts that match a query, per time bucket'
            cand search-users 'Find accounts by keyword'
            cand users 'Look up 1 to 100 accounts by handle or by id in one request'
            cand user-posts 'List the posts a user wrote'
            cand posts 'Read 1 to 100 posts by id or URL in one request'
            cand search 'Search recent posts'
            cand likers 'List the users who liked a post'
            cand reposters 'List the users who reposted a post'
            cand quotes 'List the posts that quote a post'
            cand whoami 'Show the authenticated user''s profile'
            cand user 'Look up a user by username'
            cand timeline 'Show your home timeline'
            cand mentions 'Show your recent mentions'
            cand like 'Like a post'
            cand unlike 'Unlike a post'
            cand hide 'Hide a reply to your post'
            cand unhide 'Show a hidden reply to your post again'
            cand repost 'Repost a post'
            cand unrepost 'Undo a repost'
