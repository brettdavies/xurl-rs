{
  "$defs": {
    "ApiError": {
      "additionalProperties": true,
      "description": "Partial error returned alongside valid data in 200 responses.",
      "properties": {
        "detail": {
          "description": "Longer human-readable detail.",
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "description": "Short human-readable error description.",
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "description": "Error category title (e.g. `\"Not Found Error\"`).",
          "type": [
            "string",
            "null"
          ]
        },
        "type": {
          "description": "URI identifying the error type (problem-details style).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Includes": {
      "additionalProperties": true,
      "description": "Expanded objects included alongside the primary data.",
      "properties": {
        "posts": {
          "description": "Post objects referenced by `referenced_posts`. X may send this under its legacy name `tweets`; either name fills this field.",
          "items": {
            "$ref": "#/$defs/Post"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "users": {
          "description": "User objects referenced by `author_id`, `sender_id`, etc.",
          "items": {
            "$ref": "#/$defs/User"
          },
          "type": [
            "array",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Post": {
      "additionalProperties": true,
      "description": "A post object from the X API v2.\n\nRequired fields: `id`, `text` (always present in API responses).\nOptional fields depend on which `post.fields` the caller requests.",
      "properties": {
        "attachments": {
          "description": "Media / poll attachment references — opaque JSON."
        },
        "author_id": {
          "description": "Author's user ID; resolve via `includes.users` when expanded.",
          "type": [
            "string",
            "null"
          ]
        },
        "conversation_id": {
          "description": "Root post ID of the conversation thread.",
          "type": [
            "string",
            "null"
          ]
        },
        "created_at": {
          "description": "ISO-8601 timestamp the post was created.",
          "type": [
            "string",
            "null"
          ]
        },
        "entities": {
          "description": "Parsed entities (URLs, mentions, hashtags) — opaque JSON."
        },
        "id": {
          "description": "Post identifier (X API snowflake string).",
          "type": "string"
        },
        "in_reply_to_user_id": {
          "description": "User ID this post replies to, when applicable.",
          "type": [
            "string",
            "null"
          ]
        },
        "public_metrics": {
          "anyOf": [
            {
              "$ref": "#/$defs/PostPublicMetrics"
            },
            {
              "type": "null"
            }
          ],
          "description": "Engagement counts (likes, replies, reposts, etc)."
        },
        "referenced_posts": {
          "description": "Posts this one references (reply, quote, repost). X may send this under its legacy name `referenced_tweets`; either name fills this field.",
          "items": {
            "$ref": "#/$defs/ReferencedPost"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "text": {
          "description": "Post body text.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "text"
      ],
      "type": "object"
    },
    "PostPublicMetrics": {
      "additionalProperties": true,
      "description": "Public engagement metrics for a post.",
      "properties": {
        "bookmark_count": {
          "default": 0,
          "description": "Bookmark count.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "impression_count": {
          "default": 0,
          "description": "View count.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "like_count": {
          "default": 0,
          "description": "Like count.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "quote_count": {
          "default": 0,
          "description": "Quote-post count.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "reply_count": {
          "default": 0,
          "description": "Reply count.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "repost_count": {
          "default": 0,
          "description": "Repost count. X may send this under its legacy name `retweet_count`; either name fills this field.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "ReferencedPost": {
      "additionalProperties": true,
      "description": "A referenced post (reply-to, quote, repost).",
      "properties": {
        "id": {
          "description": "Referenced post identifier.",
          "type": "string"
        },
        "type": {
          "description": "Reference kind — `\"replied_to\"`, `\"quoted\"`, or `\"retweeted\"`.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type"
      ],
      "type": "object"
    },
    "ResponseMeta": {
      "additionalProperties": true,
      "description": "Pagination and result count metadata.",
      "properties": {
        "next_token": {
          "description": "Opaque cursor for the next page; pass to a follow-up call as\n`pagination_token`.",
          "type": [
            "string",
            "null"
          ]
        },
        "previous_token": {
          "description": "Opaque cursor for the previous page.",
          "type": [
            "string",
            "null"
          ]
        },
        "result_count": {
          "description": "Total items returned in `data` for list endpoints.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "ScheduledCall": {
      "additionalProperties": true,
      "description": "A call on the authenticated user's calendar, at one of its occurrences.\n\nEvery field is optional because the spec requires none of them. A call on\na linked Outlook calendar has no `id`.",
      "properties": {
        "calendar": {
          "description": "Where the call lives: `x` for X Calls, or `outlook` for a linked\nMicrosoft Outlook calendar.",
          "type": [
            "string",
            "null"
          ]
        },
        "call_id": {
          "description": "The X call people join. It is also the call's join secret.",
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "description": "What the call is about.",
          "type": [
            "string",
            "null"
          ]
        },
        "end_time": {
          "description": "End of this occurrence, RFC 3339.",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "description": "Scheduled-call identifier: what updating, cancelling, and answering\ntake.",
          "type": [
            "string",
            "null"
          ]
        },
        "invitees": {
          "description": "Everyone invited other than the organizer, with each answer.",
          "items": {
            "$ref": "#/$defs/ScheduledCallInvitee"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "join_url": {
          "description": "The link people open to join the call on X.",
          "type": [
            "string",
            "null"
          ]
        },
        "occurrence_start_time": {
          "description": "For a recurring call, this occurrence's original start, RFC 3339: the\nvalue that names this occurrence to an update, a cancellation, or an\nanswer.",
          "type": [
            "string",
            "null"
          ]
        },
        "organizer_id": {
          "description": "User id of the call's organizer.",
          "type": [
            "string",
            "null"
          ]
        },
        "recurrence": {
          "description": "The RFC 5545 RRULE the call repeats by, such as\n`FREQ=WEEKLY;BYDAY=MO`.",
          "type": [
            "string",
            "null"
          ]
        },
        "start_time": {
          "description": "Start of this occurrence, RFC 3339.",
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "description": "`scheduled`, or `cancelled` for a cancelled occurrence.",
          "type": [
            "string",
            "null"
          ]
        },
        "time_zone": {
          "description": "The IANA time zone the recurrence follows.",
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "description": "Title of the call.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "ScheduledCallInvitee": {
      "additionalProperties": true,
      "description": "Someone invited to a scheduled call, other than its organizer.",
      "properties": {
        "id": {
          "description": "The invitee's user id.",
          "type": "string"
        },
        "response": {
          "description": "`accepted`, `declined`, `tentative`, or `none` for no answer yet.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "response"
      ],
      "type": "object"
    },
    "User": {
      "additionalProperties": true,
      "description": "A user object from the X API v2.\n\nRequired fields: `id`, `name`, `username`.\nOptional fields depend on which `user.fields` the caller requests.",
      "properties": {
        "created_at": {
          "description": "ISO-8601 account creation timestamp.",
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "description": "Bio / profile description.",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "description": "User identifier (X API snowflake string).",
          "type": "string"
        },
        "name": {
          "description": "Display name.",
          "type": "string"
        },
        "profile_image_url": {
          "description": "Profile image URL.",
          "type": [
            "string",
            "null"
          ]
        },
        "public_metrics": {
          "anyOf": [
            {
              "$ref": "#/$defs/UserPublicMetrics"
            },
            {
              "type": "null"
            }
          ],
          "description": "Engagement counts (followers, following, posts)."
        },
        "username": {
          "description": "Handle without the leading `@`.",
          "type": "string"
        },
        "verified": {
          "description": "Whether the account carries a verified badge.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "name",
        "username"
      ],
      "type": "object"
    },
    "UserPublicMetrics": {
      "additionalProperties": true,
      "description": "Public engagement metrics for a user.",
      "properties": {
        "followers_count": {
          "default": 0,
          "description": "Follower count.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "following_count": {
          "default": 0,
          "description": "Following count.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "listed_count": {
          "default": 0,
          "description": "Number of public lists the user is on.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "post_count": {
          "default": 0,
          "description": "Post count for the user. X sends this under its legacy name `tweet_count`; either name fills this field.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "Standard X API v2 response envelope. `data` holds one object for single-item endpoints and an array for list endpoints.",
  "properties": {
    "data": {
      "$ref": "#/$defs/ScheduledCall",
      "description": "Primary payload: one object, or an array for list endpoints."
    },
    "errors": {
      "description": "Partial errors returned alongside a 200 response.",
      "items": {
        "$ref": "#/$defs/ApiError"
      },
      "type": [
        "array",
        "null"
      ]
    },
    "includes": {
      "anyOf": [
        {
          "$ref": "#/$defs/Includes"
        },
        {
          "type": "null"
        }
      ],
      "description": "Expanded objects referenced by `data` when the caller requested\n`expansions=...`."
    },
    "meta": {
      "anyOf": [
        {
          "$ref": "#/$defs/ResponseMeta"
        },
        {
          "type": "null"
        }
      ],
      "description": "Pagination and result-count metadata."
    }
  },
  "required": [
    "data"
  ],
  "title": "ApiResponse",
  "type": "object"
}
