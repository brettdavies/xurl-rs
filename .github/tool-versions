# The version of every tool CI installs by binstall or download, and of every tool
# the git hooks run. CI's install steps and scripts/dev-setup.sh read this file
# through scripts/tool-version.sh, and crates/xurl-cli/tests/dev_setup_tests.rs
# fails for a ci.yml step that installs anything else.
#
# One `name=version` per line: the crate or Homebrew formula, and an exact release
# at least 7 days old. Raising agentnative also settles the audit's score floor in
# ci.yml, in the same change.

# Rust tools, installed by cargo binstall.
agentnative=0.6.0
cargo-deny=0.20.2
cargo-hack=0.6.45
cargo-nextest=0.9.150

# Installed by Homebrew, which serves only a formula's current release, so each of
# these is the oldest version that passes. bash is the oldest the hooks run under.
actionlint=1.7.12
bash=4.4.0
bats-core=1.14.0
markdownlint-cli2=0.24.0
ripgrep=15.2.0
shellcheck=0.11.0
