{
  "bypass_actors": [
    {
      "actor_id": 5,
      "actor_type": "RepositoryRole",
      "bypass_mode": "always"
    }
  ],
  "conditions": {
    "ref_name": {
      "exclude": [],
      "include": [
        "refs/heads/main"
      ]
    }
  },
  "enforcement": "active",
  "name": "Protect main",
  "rules": [
    {
      "type": "creation"
    },
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "parameters": {
        "allowed_merge_methods": [
          "squash"
        ],
        "dismiss_stale_reviews_on_push": false,
        "require_code_owner_review": false,
        "require_extra_approval_for_unattributed_changes": true,
        "require_last_push_approval": false,
        "required_approving_review_count": 0,
        "required_review_thread_resolution": false,
        "required_reviewers": []
      },
      "type": "pull_request"
    },
    {
      "type": "required_signatures"
    },
    {
      "parameters": {
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          {
            "context": "ci / Fmt, clippy, test"
          },
          {
            "context": "ci / Package check"
          },
          {
            "context": "ci / Security audit (bans licenses sources)"
          },
          {
            "context": "ci / Changelog"
          },
          {
            "context": "guard-docs / check-forbidden-docs"
          },
          {
            "context": "guard-provenance / check-provenance"
          },
          {
            "context": "guard-release / check-release-branch-name"
          },
          {
            "context": "ci / Security audit (advisories)"
          }
        ],
        "strict_required_status_checks_policy": true
      },
      "type": "required_status_checks"
    },
    {
      "type": "required_linear_history"
    }
  ],
  "target": "branch"
}
