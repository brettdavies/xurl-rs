{
  "bypass_actors": [
    {
      "actor_id": 5,
      "actor_type": "RepositoryRole",
      "bypass_mode": "always"
    }
  ],
  "conditions": {
    "ref_name": {
      "exclude": [],
      "include": [
        "refs/heads/dev"
      ]
    }
  },
  "enforcement": "active",
  "name": "Protect dev",
  "rules": [
    {
      "type": "required_signatures"
    },
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "parameters": {
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          {
            "context": "Completions freshness"
          },
          {
            "context": "Consumer check"
          },
          {
            "context": "Doc build"
          },
          {
            "context": "Feature powerset"
          },
          {
            "context": "Features (all features)"
          },
          {
            "context": "Features (default)"
          },
          {
            "context": "Features (native-tls only)"
          },
          {
            "context": "Features (no TLS backend)"
          },
          {
            "context": "Features (rustls only)"
          },
          {
            "context": "Features (testing)"
          },
          {
            "context": "Output discipline"
          },
          {
            "context": "Public API semver"
          },
          {
            "context": "Surface growth needs a minor section"
          },
          {
            "context": "ci / Fmt, clippy, test"
          },
          {
            "context": "ci / Package check"
          },
          {
            "context": "ci / Security audit (advisories)"
          },
          {
            "context": "ci / Security audit (bans licenses sources)"
          },
          {
            "context": "ci / Shellcheck"
          },
          {
            "context": "ci / Windows check"
          }
        ],
        "strict_required_status_checks_policy": false
      },
      "type": "required_status_checks"
    }
  ],
  "target": "branch"
}
